# ------------------------------------------------------------
.supabase/
supabase/.temp/

# IMPORTANT:
# Keep migration.sql and seed files tracked.
# Do NOT ignore:
#
# database/migration.sql
# database/seed_database.py
# database/seed_data/

# ------------------------------------------------------------
# Generated EXE / Packaging
# ------------------------------------------------------------
*.exe

# Keep build configuration tracked:
# *.spec

# PyInstaller
*.manifest
*.toc

