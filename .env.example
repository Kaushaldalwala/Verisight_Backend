# Supabase Credentials (Cloud Authentication & Scan Logging)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_anon_key
SUPABASE_SECRET_KEY=your_service_role_key
SUPABASE_JWKS_URL=https://your-supabase-project.supabase.co/auth/v1/.well-known/jwks.json

# Optional Tesseract Path (Fallback for Aadhaar OCR)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Module 2 Document Validation Configuration
VALIDATION_DB_PATH=backend/data/synthetic_validation.db
DATA_PROVIDER=synthetic # synthetic | government | hybrid
FUZZY_NAME_THRESHOLD=85.0
VALIDATION_PASS_THRESHOLD=80.0
MANUAL_REVIEW_THRESHOLD=50.0

# Optional Government Provider Credentials
GOV_API_URL=
GOV_API_KEY=
GOV_API_SECRET=
